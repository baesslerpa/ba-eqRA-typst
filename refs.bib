	url = {https://dl.acm.org/doi/10.1145/321386.321399},
	doi = {10.1145/321386.321399},
	abstract = {A simple “mechanical” procedure is described for checking equality of regular expressions. The procedure, based on the work of A. Salomaa, uses derivatives of regular expressions and transition graphs.
            
              Given a regular expression
              R
              , a corresponding transition graph is constructed. It is used to generate a finite set of left-linear equations which characterize
              R
              . Two regular events
              R
              and
              S
              are equal if and only if each constant term in the set of left-linear equations formed for the pair (
              R S
              ) is (φ φ) or ({\textasciicircum} {\textasciicircum}).
            
            The procedure does not involve any computations with or transformations of regular expressions and is especially appropriate for the use of a computer.},
	language = {en},
	number = {2},
	urldate = {2026-11-22},
	journal = {Journal of the ACM},
